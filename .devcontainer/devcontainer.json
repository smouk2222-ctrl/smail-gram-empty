{
  "name": "OwpenGram Codespace",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.25"
    }
  },
  "postCreateCommand": "mkdir -p bin logs && go build -o bin/owpengram-ctl ./cmd/owpengram-ctl",
  "postStartCommand": "bash .devcontainer/start-server.sh",
  "forwardPorts": [2600, 2398, 2401],
  "portsAttributes": {
    "2600": { "label": "OwpenGram Admin Panel", "visibility": "private", "onAutoForward": "notify" },
    "2398": { "label": "OwpenGram MTProto", "visibility": "private", "onAutoForward": "silent" },
    "2401": { "label": "OwpenGram Public Links", "visibility": "private", "onAutoForward": "silent" }
  }
}
